SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Email provider — set one of: resend | postmark
EMAIL_PROVIDER=resend
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=

EMAIL_FROM="LinksInvite <notifications@linksinvite.com>"
EMAIL_WEBHOOK_SECRET=

# Vercel Cron secret — Vercel injects this automatically as
# "Authorization: Bearer <value>" on cron-triggered requests.
# Generate any random string (e.g. openssl rand -hex 32) and set it
# in Vercel project settings → Environment Variables as well.
CRON_SECRET=

# Base URL used in email links (no trailing slash)
# Local dev: http://localhost:3000
# Production: https://linksinvite.com
PUBLIC_APP_URL=http://localhost:3000
